menu "File systems"

config FS_SYSFS
	bool "sysfs (device tree under /sys)"
	depends on VFS
	default y
	help
	  Present the unified device registry as empty directories under
	  /sys/devices/<device-name>.

config FS_FATFS
	bool "fatfs (FAT filesystem via VFS)"
	depends on VFS && DRIVER_BLOCK_DEVICE
	default n
	help
	  Mount FAT volumes on block devices into the VFS at /fatN, backed by
	  the FatFs library. Read-only; files are resolved on demand.

endmenu
