menuconfig DRIVER_BLOCK_DEVICE
	bool "Support Block Device Model"
	select DRIVER_DEVICE_MODEL
	default	n
	help
		Support block device driver model.

if DRIVER_BLOCK_DEVICE

config DRIVER_BLOCK_DEVICE_SDHCI_DWC
	bool "Designware SDHCI"
	default n
	help
		Designware SDHCI device driver.

config DRIVER_BLOCK_DEVICE_VIRTIO
	bool "virtio-blk (virtio-mmio)"
	default n
	help
		virtio-blk block device over virtio-mmio (e.g. QEMU virt).
endif

